{
  "name": "slskd-cli",
  "version": "0.1.0-beta.1",
  "description": "Agent-first command-line client for slskd",
  "homepage": "https://github.com/lhrnd0/slskd-cli#readme",
  "bugs": {
    "url": "https://github.com/lhrnd0/slskd-cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhrnd0/slskd-cli.git"
  },
  "bin": {
    "slskd": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "commitlint": "commitlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test",
    "package:check": "pnpm run build && node scripts/package-check.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
