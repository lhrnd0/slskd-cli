{
  "name": "slskd-cli",
  "version": "0.1.0",
  "description": "Agent-first command-line client for slskd",
  "bin": {
    "slskd-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
